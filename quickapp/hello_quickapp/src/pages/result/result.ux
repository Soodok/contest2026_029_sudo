<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page" @swipe="onSwipe">
    <!-- 状态栏：时间 + 标题「搜索结果」（对齐 index.ux 内嵌状态栏风格） -->
    <div class="statusbar" style="height: {{statusbarHeight}}px; padding-top: {{topBarPadTop}}px;">
      <div class="sb-left" if="{{showRectTitle}}"></div>
      <text class="rect-title" if="{{showRectTitle}}">搜索结果</text>
      <div class="sb-block">
        <text class="time">{{time}}</text>
        <text class="app-title" if="{{showAppTitle}}">搜索结果</text>
      </div>
    </div>

    <!-- 搜索框：点击弹出/收起键盘；显示当前 searchQuery（无词显示灰色占位） -->
    <div class="search-wrap">
      <div class="search-box" @click="toggleKeyboard" style="padding-left: {{searchBoxPadding}}px;">
        <image class="search-box-icon" src="/common/icons/search.png" if="{{!searchQuery}}"></image>
        <text class="search-placeholder" if="{{!searchQuery}}">点击输入关键词</text>
        <text class="search-input" if="{{searchQuery}}">{{displayQuery}}</text>
        <text class="clear-btn" if="{{searchQuery}}" @click="clearSearch">✕</text>
      </div>
    </div>

    <!-- 结果计数（键盘收起且有搜索记录时显示） -->
    <text class="result-count" if="{{searched && !showKeyboard && !loading}}">共 {{totalCount}} 条结果</text>

    <!-- 引擎未加载提示：点击跳转设置加载数据 -->
          <text class="engine-tip" if="{{showEngineTip}}" @click="goSettings">数据未就绪 · 点此去设置检查</text>

    <!-- 结果列表：滚动到底自动加载下一页 -->
    <scroll class="result-area" scroll-y="true" onscrollbottom="onScrollBottom">
      <div class="result-item" for="{{displayList}}" @click="gotoDetail($item.id)">
        <text class="result-year">{{$item.yearDisplay}}</text>
        <text class="result-title">{{$item.title}}</text>
        <text class="result-region">{{$item.region}}</text>
      </div>
      <text class="empty-tip" if="{{searched && displayList.length === 0 && !loading}}">无结果</text>
      <text class="empty-tip" if="{{!searched && displayList.length === 0}}">输入关键词开始搜索</text>
      <text class="loading-tip" if="{{loading}}">加载中...</text>
      <text class="empty-tip" if="{{allLoaded && displayList.length > 0}}">— 已显示全部 —</text>
    </scroll>

    <!-- 键盘区：absolute 底部覆盖，弹出时列表区域被压缩/覆盖 -->
    <div class="kb-wrap" show="{{showKeyboard}}">
      <div class="kb-body kb-rect" if="{{screentype === 'rect'}}">
        <input-method hide="{{!showKeyboard}}" keyboardtype="QWERTY" screentype="rect" maxlength="20" @complete="onInput" @delete="onDelete"></input-method>
      </div>
      <div class="kb-body kb-circle" if="{{screentype === 'circle'}}">
        <input-method hide="{{!showKeyboard}}" keyboardtype="QWERTY" screentype="circle" maxlength="20" @complete="onInput" @delete="onDelete"></input-method>
      </div>
      <div class="kb-body kb-pill" if="{{screentype === 'pill-shaped'}}">
        <input-method hide="{{!showKeyboard}}" keyboardtype="QWERTY" screentype="pill-shaped" maxlength="20" @complete="onInput" @delete="onDelete"></input-method>
      </div>
    </div>
  </div>
</template>

<style>
  /* ===== 基础样式（矩形 rect，designWidth 300 基准） ===== */
  .page { position: relative; width: 100%; height: 100%; background-color: #000000; flex-direction: column; align-items: center; }

  /* 状态栏：对齐 index.ux 三栏 flex（sb-left / rect-title / sb-block），矩形标题居中、右上时间 */
  .statusbar { width: 100%; flex-direction: row; justify-content: flex-end; align-items: center; padding-left: 30px; padding-right: 30px; flex-shrink: 0; }
  .sb-left { flex: 1; }
  .sb-block { flex: 1; flex-direction: column; align-items: flex-end; }
  .time { font-size: 16px; color: #757575; font-weight: 400; }
  .app-title { font-size: 18px; color: #FFFFFF; font-weight: 500; margin-top: 3px; }
  .rect-title { flex: 1; text-align: center; font-size: 20px; color: #FFFFFF; font-weight: 500; }

  /* 搜索框：深色圆角输入框，放大镜靠左，输入文字 flex 撑开，✕ 清空 */
  .search-wrap { position: relative; z-index: 30; flex-shrink: 0; }
  .search-box { width: 258px; height: 56px; border-radius: 28px; background-color: #1C1C1E; border: 2px solid #3A3A3C; flex-direction: row; justify-content: flex-start; align-items: center; padding-left: 18px; margin-top: 16px; flex-shrink: 0; }
  .search-box-icon { width: 24px; height: 24px; flex-shrink: 0; }
  .search-placeholder { font-size: 20px; color: #757575; flex: 1; margin-left: 10px; text-align: left; }
  .search-input { font-size: 22px; color: #FFFFFF; flex: 1; margin-left: 10px; text-align: left; }
  .clear-btn { width: 28px; height: 28px; border-radius: 14px; background-color: #3A3A3C; color: #FFFFFF; text-align: center; font-size: 18px; line-height: 28px; margin-right: 14px; flex-shrink: 0; }

  .result-count { width: 100%; text-align: center; font-size: 16px; color: #757575; margin-top: 6px; flex-shrink: 0; }

  /* 引擎未加载提示：黄色醒目，点击跳设置 */
  .engine-tip { width: 100%; text-align: center; font-size: 18px; color: #FBBC05; margin-top: 8px; flex-shrink: 0; }

  /* 结果列表 */
  .result-area { width: 100%; flex: 1; flex-direction: column; }
  .result-item { width: 94%; margin-left: 3%; border-radius: 14px; background-color: #1C1C1E; padding: 10px 14px; margin-bottom: 6px; flex-direction: column; flex-shrink: 0; }
  .result-year { font-size: 20px; font-weight: bold; color: #4D9FEE; margin-bottom: 2px; }
  .result-title { font-size: 22px; color: #FFFFFF; margin-bottom: 1px; }
  .result-region { font-size: 17px; color: #757575; }

  .empty-tip { width: 100%; text-align: center; font-size: 18px; color: #757575; margin-top: 40px; }
  .loading-tip { width: 100%; text-align: center; font-size: 16px; color: #757575; margin-top: 10px; }

  /* 键盘区：absolute 底部；rect 用原组件（255px 流体布局，designWidth 300 下即满宽）；
     circle 组件原生画布 480px，整体缩放 0.625 至 300px 满宽（缩小时命中区域 ⊇ 视觉，安全）；
     pill 组件内部已按 300 基准重写（见 InputMethod.ux），此处直接撑满。 */
  .kb-wrap { position: absolute; left: 0; bottom: 0; width: 100%; overflow: visible; z-index: 20; }
  /* 三个形态容器均设 position:relative，作为 input-method 根节点（absolute bottom:0）的定位上下文；
     circle 画布 480px 需居中：屏幕中心 x=150 → 盒左偏移 -90（300 设计宽恒定），transform-origin 为盒中心底 */
  .kb-rect { position: relative; width: 100%; height: 255px; }
  .kb-circle { position: relative; left: -90px; width: 480px; height: 321px; transform: scale(0.625); transform-origin: 240px 321px; }
  .kb-pill { position: relative; width: 100%; height: 477px; }

  /* ===== 圆屏 466（Watch S3/S4）：designWidth 300 → 300×300 ===== */
    /* ===== 胶囊 192x490（手环 9）：designWidth 300 → 300×767 ===== */
  @media (shape: pill-shaped) {
    .statusbar { justify-content: center; padding-left: 0; padding-right: 0; }
    .sb-block { align-items: center; }
    .time { font-size: 21px; }
    .app-title { font-size: 26px; }
    .search-box { width: 246px; height: 92px; border-radius: 46px; margin-top: 20px; border: 3px solid #3A3A3C; padding-left: 30px; }
    .search-box-icon { width: 40px; height: 40px; }
    .search-placeholder { font-size: 30px; margin-left: 16px; }
    .search-input { font-size: 34px; margin-left: 16px; }
    .clear-btn { width: 46px; height: 46px; border-radius: 23px; font-size: 28px; line-height: 46px; margin-right: 22px; }
    .result-count { font-size: 24px; margin-top: 10px; }
    .result-item { border-radius: 26px; padding: 16px 22px; margin-bottom: 10px; }
    .result-year { font-size: 32px; }
    .result-title { font-size: 36px; }
    .result-region { font-size: 28px; }
    .empty-tip { font-size: 28px; margin-top: 60px; }
    .loading-tip { font-size: 24px; }
    .engine-tip { font-size: 28px; }
  }
</style>

<script>
  import router from '@system.router'
  import device from '@system.device'

  // 手写补零（避免 padStart 的轻量运行时兼容风险）
  function pad2(n) {
    return n < 10 ? '0' + n : '' + n
  }

  export default {
    private: {
      time: '00:00',
      timeTimer: null,
      statusbarHeight: 22,
      topBarPadTop: 0,
      showAppTitle: false,
      showRectTitle: true,
      screentype: 'rect',
      screenAdjusted: false,
      showKeyboard: false,
      searchQuery: '',
      displayList: [],
      totalCount: 0,
      currentPage: 1,
      pageSize: 20,
      loading: false,
      allLoaded: false,
      searched: false,
      activeCategory: 'all',
      activeRegion: 'all',
      searchTimer: null,
      isClearing: false,
      showEngineTip: false,
      // 无词进入时延迟到 screentype 确定后再自动弹键盘（避免 onInit 以默认 rect 渲染小键盘闪切）
      shouldOpenKeyboard: false,
      // 页面销毁标志：延迟弹键盘的回调到达时若已退出则跳过
      isDestroyed: false
    },

    computed: {
      // 键盘打开时追加光标（与组件内部 caltext 的「_」光标一致，避免特殊字符缺字）
      displayQuery() {
        return this.searchQuery + (this.showKeyboard ? '_' : '')
      },
      // 搜索框左内边距：有词时缩小给文字留空间，无词时按形态取默认
      searchBoxPadding() {
        if (this.searchQuery) return 6
        if (this.screentype === 'pill-shaped') return 30
        if (this.screentype === 'circle') return 12
        return 18
      }
    },

    onInit() {
      this.searchQuery = global.searchQuery || ''
      this.activeCategory = global.searchCategory || 'all'
      this.activeRegion = global.searchRegion || 'all'
      this.updateTime()
      this.timeTimer = setInterval(() => { this.updateTime() }, 30000)
      // 有词直接加载；无词等待弹键盘（延迟到 onShow 拿到 screentype 后再弹）
      if (this.searchQuery && this.searchQuery.trim()) {
        this.searched = true
        this.resetAndSearch()
      } else {
        // 不能在此立即 showKeyboard=true：onInit 时 DOM 未 ready、screentype 还是默认 'rect'，
        // 立即弹出会先渲染 rect 小键盘再切回正确形态（用户看到「打开瞬间缩小再变正常」）
        this.shouldOpenKeyboard = true
      }
      if (typeof global.addRuntimeLog === 'function') {
        global.addRuntimeLog('结果页打开，搜索词: ' + global.searchQuery, 'info')
      }
    },

    // onShow 时 DOM 已 ready，获取屏幕信息做形态/安全偏移适配（仅执行一次）；
    // 若此前提示「未加载」而引擎现已就绪（用户去设置加载完返回），自动清除提示并重搜
    onShow() {
      var eng = global.searchEngine
      if (this.showEngineTip && eng && eng.isReady) {
        this.showEngineTip = false
        this.resetAndSearch()
      }
      if (this.screenAdjusted) return
      this.screenAdjusted = true
      this.adjustForScreen()
    },

    onDestroy() {
      this.isDestroyed = true
      if (this.timeTimer) clearInterval(this.timeTimer)
      if (this.searchTimer) clearTimeout(this.searchTimer)
    },

    updateTime() {
      var now = new Date()
      this.time = pad2(now.getHours()) + ':' + pad2(now.getMinutes())
    },

    // 形态/安全偏移适配：状态栏高度 = 设计高 + 物理安全偏移换算的设计 px（同 index.ux）
    adjustForScreen() {
      var self = this
      device.getInfo({
        success: function(data) {
          var screenWidth = data.screenWidth
          var shape = data.screenShape
          var safeTopPx = 0
          var base = 22
          if (shape === 'pill-shaped') {
            safeTopPx = 12
            base = 50
          } else if (shape === 'circle') {
            safeTopPx = 10
            base = 26
          }
          var padTop = safeTopPx > 0 ? Math.round(safeTopPx * 300 / screenWidth) : 0
          self.topBarPadTop = padTop
          self.statusbarHeight = base + padTop
          self.showAppTitle = (shape === 'pill-shaped') || (shape === 'circle')
          self.showRectTitle = !self.showAppTitle
          self.screentype = shape === 'circle' ? 'circle' : shape === 'pill-shaped' ? 'pill-shaped' : 'rect'
          console.log('[RESULT] shape=' + shape + ' screentype=' + self.screentype + ' statusbarH=' + self.statusbarHeight)
          if (typeof global.addRuntimeLog === 'function') {
            global.addRuntimeLog('[RESULT] shape=' + shape + ' screentype=' + self.screentype, 'info')
          }
          // screentype 已确定，此刻 input-method(pill) 组件才刚开始 mount（构建 DOM + 加载键盘图），
          // 立即 showKeyboard 会与组件构建同帧导致弹出卡顿；延迟约 150ms 等组件就绪再弹出
          if (self.shouldOpenKeyboard) {
            self.shouldOpenKeyboard = false
            setTimeout(function() {
              if (self && !self.isDestroyed) {
                self.showKeyboard = true
              }
            }, 150)
          }
        },
        fail: function() {
          // getInfo 异常兜底：保持默认 rect，仍要完成无词自动弹键盘
          if (self.shouldOpenKeyboard) {
            self.shouldOpenKeyboard = false
            setTimeout(function() {
              if (self && !self.isDestroyed) {
                self.showKeyboard = true
              }
            }, 150)
          }
        }
      })
    },

    // 点搜索框：开/收键盘，收起时触发搜索
    toggleKeyboard() {
      if (this.isClearing) return
      this.shouldOpenKeyboard = false // 用户已手动操作，getInfo 回调不再自动弹键盘
      this.showKeyboard = !this.showKeyboard
      if (!this.showKeyboard) {
        this.finishInput()
      }
    },

    // 点「完成」：收起键盘并立即搜索
    finishInput() {
      this.showKeyboard = false
      this.resetAndSearch()
    },

    // 清空关键词（清空时保持键盘打开状态，可继续输入）
    clearSearch() {
      this.isClearing = true
      this.searchQuery = ''
      global.searchQuery = ''
      this.displayList = []
      this.totalCount = 0
      this.currentPage = 1
      this.allLoaded = false
      this.searched = false
      var self = this
      setTimeout(function() { self.isClearing = false }, 200)
    },

    // @complete：键盘逐字符提交（拼音候选/英文字母/空格），追加到关键词并实时搜索（防抖）
    onInput(evt) {
      var content = evt.detail.content
      if (content === undefined || content === null) return
      this.searchQuery += content
      global.searchQuery = this.searchQuery
      this.scheduleSearch()
    },

    // @delete：键盘内部缓冲已空时，删除页面关键词末字符
    onDelete() {
      this.searchQuery = this.searchQuery.slice(0, -1)
      global.searchQuery = this.searchQuery
      this.scheduleSearch()
    },

    // 防抖实时搜索（避免逐键触发）
    scheduleSearch() {
      var self = this
      if (this.searchTimer) clearTimeout(this.searchTimer)
      this.searchTimer = setTimeout(function() {
        self.resetAndSearch()
      }, 400)
    },

    // 重置分页并搜索第 1 页；引擎未初始化时由 search 内部懒初始化（自动读缓存建缓存），
    // 不再需要手动「加载数据」；数据缺失时 search 返回 initFailed，由 loadPage 显示提示
    resetAndSearch() {
      var eng = global.searchEngine
      if (!eng) {
        this.showEngineTip = true
        this.displayList = []
        this.totalCount = 0
        this.currentPage = 1
        this.allLoaded = false
        this.searched = true
        return
      }
      this.showEngineTip = false
      if (!this.searchQuery || !this.searchQuery.trim()) {
        this.displayList = []
        this.totalCount = 0
        this.currentPage = 1
        this.allLoaded = false
        this.searched = false
        return
      }
      this.currentPage = 1
      this.allLoaded = false
      this.searched = true
      this.loadPage(1)
    },

    async loadPage(page) {
      if (this.loading || this.allLoaded) return
      if (!this.searchQuery || !this.searchQuery.trim()) return
      this.loading = true
      try {
        var result = await global.searchHistory(this.searchQuery, {
          category: this.activeCategory,
          region: this.activeRegion,
          page: page,
          pageSize: this.pageSize
        })
        // 数据缺失兜底：引擎懒初始化失败（meta 读不到）时提示去设置检查
        if (result.initFailed) {
          this.showEngineTip = true
          this.displayList = []
          this.totalCount = 0
          this.loading = false
          return
        }
        var formatted = (result.results || []).map(function(item) {
          // 取第一个关键词作为标题
          var title = item.title || '未知事件'
          if (title.indexOf(',') !== -1) {
            title = title.split(',')[0].trim()
          } else if (title.indexOf('，') !== -1) {
            title = title.split('，')[0].trim()
          }
          return {
            id: item.id || item._id,
            yearDisplay: item.yearDisplay || '未知',
            title: title,
            region: item.region || '未知'
          }
        })
        if (page === 1) {
          this.displayList = formatted
        } else {
          this.displayList = this.displayList.concat(formatted)
        }
        this.totalCount = result.total || 0
        this.currentPage = page
        this.loading = false
        if (formatted.length < this.pageSize) {
          this.allLoaded = true
        }
      } catch (e) {
        console.error('[loadPage] 错误:', e)
        this.loading = false
      }
    },

    // 滚动到底自动加载下一页（键盘弹出时不触发）
    onScrollBottom() {
      if (this.showKeyboard) return
      if (this.loading || this.allLoaded) return
      if (!this.displayList.length) return
      this.loadPage(this.currentPage + 1)
    },

    gotoDetail(id) {
      if (this.showKeyboard) return
      if (this.$app.$def.isNavigating) return
      if (typeof global.addRuntimeLog === 'function') {
        global.addRuntimeLog('从结果页打开详情: ID=' + id, 'info')
      }
      global.selectedEventId = id
      router.push({ uri: '/pages/detail' })
    },

    // 数据未加载提示 → 跳设置页加载数据
    goSettings() {
      if (this.$app.$def.isNavigating) return
      router.push({ uri: '/pages/settings' })
    },

    // 右滑返回；键盘弹出时先收起键盘
    onSwipe(eve) {
      if (eve.direction === 'right') {
        if (this.showKeyboard) {
          this.finishInput()
          return
        }
        if (this.$app.$def.isNavigating) return
        router.back()
      }
    }
  }
</script>
