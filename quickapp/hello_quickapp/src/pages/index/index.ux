<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page-container" @swipe="onSwipe">
    <!-- 整页纵向滚动：两块各占一屏，滑动停止后自动吸附（类似番茄钟分页）；每屏自带状态栏；搜索态结果随其滚动 -->
    <scroll id="pageScroll" class="page-scroll" scroll-y="{{!voiceActive}}" onscroll="onPageScroll" onscrollbottom="onPageScrollBottom">
      <!-- 第一块：顶部块。高度由 style 动态提供（screen1H）：非搜索态=整屏高（与第二屏构成
           双屏吸附），搜索态=头部高（状态栏+搜索框）让结果区紧跟其后进入 pageScroll 内容流。
           ⚠️ 结果列表不能放进固定高容器、也不能包内层 scroll（v1.16.11/v1.16.29 两次教训）：
           嵌套 scroll 或 flex:1 失效都会造成「内容溢出不可见 + 手势死区 = 滑不动」。
           现在结果区是 pageScroll 的直接子项，随内容自然撑高，单层滚动。 -->
      <div class="screen1" style="height: {{screen1H}}px;">
        <!-- 状态栏时间 + 应用名（每屏独立渲染，随内容滚动）；搜索态标题切换为 searchTitle -->
        <div class="statusbar">
          <!-- 矩形手表：左占位 + 顶部居中标题 + 右上时间（三栏 flex 均分保证标题绝对居中） -->
          <div class="sb-left" if="{{showRectTitle}}"></div>
          <text class="rect-title" if="{{showRectTitle}}">{{headerTitle}}</text>
          <div class="sb-block">
            <text class="time">{{time}}</text>
            <text class="app-title" if="{{showAppTitle}}">{{headerTitle}}</text>
          </div>
        </div>

        <!-- 搜索框：常驻顶部；非搜索态点击进入搜索，搜索态点击开/收键盘；有词显示输入内容与 ✕ -->
        <div class="search-box {{searchBoxClass}}" @click="toggleSearchBox">
          <image class="search-box-icon" src="/common/icons/search.png" if="{{!searchQuery && !voiceActive}}"></image>
          <text class="search-placeholder" if="{{searchActive && !searchQuery && !voiceActive}}">请输入</text>
          <text class="search-input" if="{{searchActive && searchQuery && !voiceActive}}">{{displayQuery}}</text>
          <text class="clear-btn" if="{{searchActive && searchQuery && !voiceActive}}" @click="clearSearch">✕</text>
          <text class="voice-text" if="{{voiceActive}}">{{voiceText}}</text>
        </div>

        <!-- 引导词：非搜索态、非语音态显示 -->
        <text class="guide" if="{{!searchActive && !voiceActive}}">{{guideText}}</text>

        <!-- 分类横滑行：非搜索态、非语音态显示 -->
        <scroll id="catScroll" class="cat-scroll" if="{{!searchActive && !voiceActive && !dsViewActive}}" scroll-x="{{true}}" onscroll="onCatScroll">
          <div class="cat-row">
            <div class="cat-item" for="{{displayCats}}" @click="goCategory($item)">
              <div class="cat-icon {{$item.colorClass}}">
                <image class="cat-icon-img" src="{{$item.icon}}"></image>
              </div>
              <text class="cat-text">{{$item.name}}</text>
            </div>
          </div>
        </scroll>
        <!-- 资料详情视图（v1.16.31）：点大类/资料后替换分类行，展示单个资料图标+简介+标签。
             标签=该集 meta 的原分类词(regionList)，点击变蓝表示「只搜带此标签的资料」。
             v1.16.37：搜索态隐藏（搜索后表现与主界面搜索一致，标题变为「集名·搜索」） -->
        <div class="ds-view" if="{{dsViewActive && !searchActive && !voiceActive}}">
          <div class="ds-head">
            <div class="ds-icon-box {{dsInfo.colorClass}}">
              <image class="ds-icon" src="{{dsInfo.icon}}"></image>
            </div>
            <text class="ds-name">{{dsInfo.name}}</text>
          </div>
          <text class="ds-desc">{{dsInfo.desc}}</text>
          <scroll class="ds-tags-scroll" scroll-x="{{true}}">
            <div class="ds-tags">
              <div class="{{$item.cls}}" for="{{dsTags}}" @click="pickTag($item)">
                <text class="ds-tag-text">{{$item.label}}</text>
              </div>
            </div>
          </scroll>
          <div class="ds-actions">
            <div class="ds-back" @click="exitDsView"><text class="ds-back-text">返回</text></div>
          </div>
        </div>

    <!-- 两个搜索按钮：矩形左右排列、胶囊/圆形上下排列；左「语音搜索」、右「AI搜索」 -->
        <div class="search-btn-row" if="{{!searchActive && !showKeyboard && !voiceActive}}">
          <div class="search-btn search-btn-l" @click="startVoiceSearch">
            <image class="search-icon" src="/common/icons/voice.png"></image>
            <text if="{{!isCircle}}" class="search-text">语音搜索</text>
          </div>
          <div class="search-btn search-btn-r" @click="goSearch">
            <image class="search-icon" src="/common/icons/ai.png"></image>
            <text if="{{!isCircle}}" class="search-text">AI搜索</text>
          </div>
        </div>

        <!-- 语音聆听态：蓝牙未连接显示断开图标+提示，已连接显示波形动画（随音量）；取消按钮 -->
        <div class="voice-panel" if="{{voiceActive}}">
          <image class="voice-bt-off" src="/common/icons/bluetooth_off.png" if="{{!bluetoothConnected}}"></image>
          <text class="voice-tip" if="{{!bluetoothConnected}}">蓝牙未连接</text>
          <text class="voice-tip" if="{{bluetoothConnected}}">{{voiceStatusText}}</text>
          <image class="voice-anim" src="{{voiceWaveSrc}}" if="{{bluetoothConnected}}"></image>
          <div class="voice-cancel" @click="exitVoiceSearch">
            <text class="voice-cancel-text">取消</text>
          </div>
        </div>

      </div>

      <!-- 搜索结果区（v1.16.37 重构）：pageScroll 的直接子项，随内容自然撑高——
           单层滚动（修复「搜完滑不动」），滚到底自动加载下一页（pageScroll 的 onscrollbottom）。
           不再使用内层 scroll（v1.16.29 方案在手环轻量运行时 flex:1 失效 → 容器被内容
           撑开成手势死区，主人实测「还是滑动不了」）。 -->
      <div class="home-result" if="{{searchActive}}">
        <!-- AI 回答卡（v1.16.33）：AI 搜索的问题回答；来源条目在其下方的结果列表 -->
        <div class="ai-card" if="{{aiMode && (aiThinking || aiAnswer)}}">
          <text class="ai-card-title">{{aiCardTitle}}</text>
          <text class="ai-card-text">{{aiCardText}}</text>
        </div>
        <text class="result-count" if="{{searched && !showKeyboard && !loading && !aiMode}}">共 {{totalCount}} 条结果</text>
        <text class="engine-tip" if="{{showEngineTip}}" @click="goSettings">数据未就绪 · 点此去设置检查</text>
        <div class="result-item" for="{{visibleList}}" @click="gotoDetail($item.id)">
          <!-- 三行类名由 DatasetManager 按 meta.display.card 预拼完整类名（纯变量插值，禁拼接表达式） -->
          <text class="{{$item.yearClass}}">{{$item.yearDisplay}}</text>
          <text class="{{$item.titleClass}}">{{$item.title}}</text>
          <text class="{{$item.catClass}}">{{$item.region}}</text>
        </div>
        <text class="empty-tip" if="{{searchError && !loading}}">搜索出错 · 请重试</text>
        <text class="empty-tip" if="{{searched && displayList.length === 0 && !loading && !searchError}}">无结果</text>
        <text class="empty-tip" if="{{!searched && displayList.length === 0}}">{{waitTip}}</text>
        <!-- 显示更多（v1.16.26 主人要求：默认只渲染 5 条，点此追加）-->
        <div class="more-btn" if="{{displayList.length > visibleCount}}" @click="showMore">
          <text class="more-text">{{moreText}}</text>
        </div>
        <text class="empty-tip" if="{{allLoaded && displayList.length > 0}}">— 已显示全部 —</text>
      </div>

      <!-- 第二块：状态栏 + 设置 / 收藏（一屏高）；搜索态隐藏（if 不占位） -->
      <div class="screen2" if="{{!searchActive}}" style="height: {{screen1H}}px;">
        <!-- 状态栏时间 + 应用名（第二屏顶部独立渲染，标题为「选项」） -->
        <div class="statusbar">
          <div class="sb-block">
            <text class="time">{{time}}</text>
            <text class="app-title" if="{{showAppTitle}}">{{secondTitle}}</text>
          </div>
        </div>

        <!-- 设置 / 收藏卡片：占满剩余高度并垂直居中 -->
        <div class="sec2-wrap">
          <div class="sec2">
            <div class="sec2-card sec2-card-first" @click="goSettings">
              <image class="sec2-icon" src="/common/icons/set.png"></image>
              <text class="sec2-text">设置</text>
            </div>
            <div class="sec2-card" @click="goFavorites">
              <image class="sec2-icon" src="/common/icons/star.png"></image>
              <text class="sec2-text">{{favoriteText}}</text>
            </div>
          </div>
        </div>
      </div>
    </scroll>

    <!-- 右侧分页指示点：当前页白色、另一页灰色；搜索态隐藏 -->
    <div class="page-dots" if="{{!searchActive}}" style="top: {{dotsTop}}px;">
      <div class="{{dot0Class}}"></div>
      <div class="{{dot1Class}}"></div>
    </div>

    <!-- 键盘区：absolute 底部；搜索态弹出（rect 组件原生 / circle 外层 scale 0.625 / pill 撑满）。
         v1.16.2 修复「键盘能开但按键全无反应」：v1.14.3 曾把 kb-wrap 移入 screen1（pageScroll 内），
         其后的 home-result-scroll（常驻 DOM、flex:1 占满搜索框以下整屏、透明背景）在 DOM 顺序上压住键盘，
         轻量运行时 z-index 不赢得命中测试 → 键盘可见但全部按键点击被 scroll 吞掉。
         现移回 page-container 根层级 + DOM 末尾（v1.13.x / result.ux / historyband9 的已验证位置）：
         绘制与命中都优先；几何不变（absolute 的包含块本来就是 page-container） -->
    <div class="kb-wrap" show="{{showKeyboard}}">
      <div class="kb-body kb-rect" if="{{screentype === 'rect'}}">
        <input-method hide="{{!showKeyboard}}" keyboardtype="QWERTY" screentype="rect" maxlength="20" @complete="onInput" @delete="onDelete"></input-method>
      </div>
      <div class="kb-body kb-circle" if="{{screentype === 'circle'}}">
        <input-method hide="{{!showKeyboard}}" keyboardtype="QWERTY" screentype="circle" maxlength="20" @complete="onInput" @delete="onDelete"></input-method>
      </div>
      <div class="kb-body kb-pill" if="{{screentype === 'pill-shaped'}}">
        <input-method hide="{{!showKeyboard}}" keyboardtype="QWERTY" screentype="pill-shaped" maxlength="20" @complete="onInput" @delete="onDelete"></input-method>
      </div>
    </div>
  </div>
</template>

<style>
  /* ===== 基础样式（矩形 rect，designWidth 300 基准） ===== */
  .page-container { position: relative; width: 100%; height: 100%; background-color: #000000; }
  .page-scroll { width: 100%; height: 100%; flex-direction: column; }

  /* 状态栏：每屏顶部普通块级（随内容滚动）；矩形时间靠右，下方小字应用名；左右对称 padding 保证三栏均分后标题落于屏正中 */
  .statusbar { width: 100%; height: 22px; flex-direction: row; justify-content: flex-end; align-items: center; padding-left: 30px; padding-right: 30px; flex-shrink: 0; }
  .sb-left { flex: 1; }
  .sb-block { flex: 1; flex-direction: column; align-items: flex-end; }
  .time { font-size: 16px; color: #757575; font-weight: 400; }
  .app-title { font-size: 18px; color: #FFFFFF; font-weight: 500; margin-top: 3px; }
  /* 矩形手表：顶部应用名（大小约胶囊 3/4），三栏 flex 均分（sb-left/rect-title/sb-block）保证水平正中心，不干扰右上时间 */
  .rect-title { flex: 1; text-align: center; font-size: 20px; color: #FFFFFF; font-weight: 500; }

  /* 第一块：高度由模板 style 动态提供（screen1H：非搜索态=整屏高 / 搜索态=头部高），
     CSS 不再固定——固定高是「搜完滑不动」的根因（结果溢出固定高容器不可滚） */
  .screen1 { width: 100%; flex-direction: column; align-items: center; flex-shrink: 0; }

  /* 分类横滑行：图标直径 58、间距 17、名称 13px；边缘留白 8.5（间距=2×边缘） */
  .cat-scroll { width: 100%; height: 82px; margin-top: 61px; flex-shrink: 0; }
  .cat-row { flex-direction: row; align-items: flex-start; padding-left: 8px; padding-right: 8px; }
  /* ===== 资料详情视图（v1.16.31，主人需求）===== */
  .ds-view { width: 100%; flex-direction: column; align-items: center; flex-shrink: 0; margin-top: 6px; }
  .ds-head { flex-direction: row; align-items: center; margin-bottom: 8px; }
  .ds-icon-box { width: 46px; height: 46px; border-radius: 23px; justify-content: center; align-items: center; }
  .ds-icon { width: 26px; height: 26px; }
  .ds-name { font-size: 24px; font-weight: 600; color: #FFFFFF; margin-left: 10px; }
  .ds-desc { width: 88%; font-size: 16px; color: #8E8E93; text-align: center; line-height: 22px; margin-bottom: 10px; }
  .ds-tags-scroll { width: 100%; height: 46px; flex-shrink: 0; }
  .ds-tags { flex-direction: row; padding: 0 14px; align-items: center; }
  .ds-tag { height: 40px; border-radius: 20px; background-color: #1C1C1E; justify-content: center; align-items: center; padding: 0 16px; margin-right: 8px; flex-shrink: 0; }
  .ds-tag-on { background-color: #4D9FEE; }
  .ds-tag-text { font-size: 17px; color: #BBBBBB; }
  .ds-actions { width: 100%; flex-direction: row; justify-content: center; margin-top: 10px; }
  .ds-back { width: 40%; height: 48px; border-radius: 24px; background-color: #2C2C2E; justify-content: center; align-items: center; flex-shrink: 0; }
  .ds-back-text { font-size: 18px; color: #FFFFFF; }

  .cat-item { width: 58px; flex-direction: column; align-items: center; margin-right: 17px; flex-shrink: 0; }
  .cat-icon { width: 58px; height: 58px; border-radius: 29px; background-color: #1C1C1E; justify-content: center; align-items: center; }
  /* Google/Material 鲜活配色图标底（语义化：健康绿/科学蓝/历史橙/生活青/急救红/运动黄） */
  .ci-green { background-color: #34A853; }
  .ci-blue { background-color: #4285F4; }
  .ci-orange { background-color: #FB8C00; }
  .ci-cyan { background-color: #24C1E0; }
  .ci-red { background-color: #EA4335; }
  .ci-yellow { background-color: #FBBC05; }
  .ci-ds { background-color: #8B5CF6; }
  .cat-icon-img { width: 33px; height: 33px; }
  .cat-text { font-size: 13px; color: #e6edf3; margin-top: 6px; }

  /* 引导词：灰色小字居中（位于分类图标上方，紧贴搜索框下方） */
  .guide { width: 100%; text-align: center; font-size: 13px; color: #5b6472; letter-spacing: 2px; margin-top: 12px; flex-shrink: 0; }

  /* 搜索框：位于状态栏下方，深色圆角输入框样式，放大镜靠左，带描边，点击进入搜索页 */
  .search-box { width: 258px; height: 56px; border-radius: 28px; background-color: #1C1C1E; border: 2px solid #3A3A3C; flex-direction: row; justify-content: flex-start; align-items: center; padding-left: 18px; margin-top: 16px; flex-shrink: 0; }
  .search-box-icon { width: 24px; height: 24px; }
  .voice-text { font-size: 20px; color: #757575; flex: 1; margin-left: 10px; text-align: left; }

  /* 搜索按钮行：矩形左右排列，胶囊/圆形上下排列 */
  .search-btn-row { width: 100%; margin-top: 86px; flex-direction: row; justify-content: center; align-items: center; margin-top: 20px; padding-left: 10px; padding-right: 10px; flex-shrink: 0; }
  .search-btn { position: relative; flex: 1; height: 67px; border-radius: 33px; background-color: #4D9FEE; flex-direction: row; justify-content: flex-start; align-items: center; flex-shrink: 0; padding-left: 14px; }
  .search-btn-l { margin-right: 4px; background-color: #34A853; }
  .search-btn-r { margin-left: 4px; background-color: #2A2A2C; }
  .search-icon { width: 21px; height: 21px; margin-right: 5px; flex-shrink: 0; }
  .voice-panel { width: 100%; flex: 1; flex-direction: column; justify-content: center; align-items: center; }
  .voice-tip { font-size: 24px; color: #FFFFFF; margin-bottom: 12px; }
  .voice-anim { width: 50px; height: 50px; }
  .voice-bt-off { width: 50px; height: 50px; margin-bottom: 12px; }
  .voice-cancel { width: 160px; height: 56px; border-radius: 28px; background-color: #3A3A3C; justify-content: center; align-items: center; margin-top: 30px; }
  .voice-cancel-text { font-size: 24px; color: #FFFFFF; }
  .search-text { font-size: 22px; color: #FFFFFF; font-weight: 400; }

  /* 第二块：状态栏固定高度在顶部，剩余空间由 sec2-wrap 撑起并让卡片垂直居中 */
  .screen2 { width: 100%; flex-direction: column; align-items: center; flex-shrink: 0; }
  .sec2-wrap { width: 100%; flex: 1; justify-content: center; align-items: center; }
  .sec2 { width: 100%; flex-direction: row; padding-left: 21px; padding-right: 21px; flex-shrink: 0; }
  .sec2-card { flex: 1; height: 150px; border-radius: 21px; background-color: #1C1C1E; flex-direction: column; justify-content: center; align-items: center; }
  .sec2-card-first { margin-right: 14px; }
  .sec2-icon { width: 36px; height: 36px; }
  .sec2-text { font-size: 17px; color: #FFFFFF; font-weight: 600; margin-top: 12px; }

  /* 分页指示点：右边缘竖排两个小圆点 */
  .page-dots { position: absolute; right: 4px; flex-direction: column; align-items: center; z-index: 10; }
  .page-dot { width: 10px; height: 10px; border-radius: 5px; margin-bottom: 12px; background-color: #4a4a4a; }
  .page-dot-active { background-color: #FFFFFF; }

  /* ===== 主页内嵌搜索（搜索态结果区替换分类行，随外层 pageScroll 滚动） ===== */
  /* 结果区独立滚动容器（v1.16.29）：占满 screen1（CSS 固定一屏高）剩余空间。
     ⚠️ 此前 flex:1 与 flex-shrink:0 并存互相冲突——flex-shrink:0 使容器被内容撑开、
     永远成不了滚动视图，结果超出后既不可见也滑不动（主人反馈「搜完滑不动」）。 */
  .home-result { width: 100%; flex-direction: column; align-items: center; flex-shrink: 0; }

  /* 搜索框内占位/输入/清空三件套（复用主页 .search-box 同名义尺寸；无独立 search-wrap 包裹） */
  .search-placeholder { font-size: 20px; color: #757575; flex: 1; margin-left: 10px; text-align: left; }
  .search-input { font-size: 22px; color: #FFFFFF; flex: 1; margin-left: 10px; text-align: left; }
  .clear-btn { width: 28px; height: 28px; border-radius: 14px; background-color: #3A3A3C; color: #FFFFFF; text-align: center; font-size: 18px; line-height: 28px; margin-right: 14px; flex-shrink: 0; }

  .result-count { width: 100%; text-align: center; font-size: 16px; color: #757575; margin-top: 6px; flex-shrink: 0; }

  /* 引擎未加载提示：黄色醒目，点击跳设置 */
  .engine-tip { width: 100%; text-align: center; font-size: 18px; color: #FBBC05; margin-top: 8px; flex-shrink: 0; }

  /* 结果列表（搜索结果随外层 pageScroll 流式滚动，无需内嵌 scroll） */
  .result-item { width: 94%; margin-left: 3%; border-radius: 14px; background-color: #1C1C1E; padding: 10px 14px; margin-bottom: 6px; flex-direction: column; flex-shrink: 0; }
  /* 「显示更多」按钮（v1.16.26）*/
  /* AI 回答卡（v1.16.33）：区别于普通结果卡的强调样式 */
  .ai-card { width: 94%; margin-left: 3%; border-radius: 14px; background-color: #1C2530; border: 1px solid #2A4A66; padding: 12px 14px; margin-bottom: 8px; flex-direction: column; flex-shrink: 0; }
  .ai-card-title { font-size: 18px; color: #4D9FEE; font-weight: 600; margin-bottom: 6px; }
  .ai-card-text { font-size: 18px; color: #E8E8E8; line-height: 26px; }
  .more-btn { width: 94%; margin-left: 3%; height: 64px; border-radius: 14px; background-color: #2C2C2E; justify-content: center; align-items: center; margin-top: 4px; margin-bottom: 8px; flex-shrink: 0; }
  .more-text { font-size: 22px; color: #4D9FEE; }
  .result-year { font-size: 20px; font-weight: bold; color: #4D9FEE; margin-bottom: 2px; }
  .result-title { font-size: 22px; color: #FFFFFF; margin-bottom: 1px; }
  .result-region { font-size: 17px; color: #757575; }
  /* 结果卡三行大小（meta.display.card.rows → DatasetManager 预拼 sz-* 类 → 模板纯变量插值）。
     仅声明了 display.card 的集（英语集）会带 sz 类；未声明的集（历史/诗词）保持上方基准字号。
     注意：sz 规则需在每个形态块内重复声明且位于 .result-* 之后，否则会被形态基准覆盖 */
  .sz-large { font-size: 30px; }
  .sz-medium { font-size: 22px; }
  .sz-small { font-size: 16px; }

  .empty-tip { width: 100%; text-align: center; font-size: 18px; color: #757575; margin-top: 40px; }

  /* 键盘区：absolute 底部；rect 用原组件（255px 满宽）、circle 画布 480px 整体 scale 0.625、
     pill 组件内部已按 300 基准重写，此处直接撑满（与 result.ux 同款） */
  .kb-wrap { position: absolute; left: 0; bottom: 0; width: 100%; overflow: visible; z-index: 20; }
  .kb-rect { position: relative; width: 100%; height: 255px; }
  .kb-circle { position: relative; left: -90px; width: 480px; height: 321px; transform: scale(0.625); transform-origin: 240px 321px; }
  .kb-pill { position: relative; width: 100%; height: 477px; }

  /* ===== 圆屏 466（Watch S3/S4）：5 个图标整行居中，不横滑 ===== */
    /* ===== 胶囊 192x490（手环 9）：设置/收藏上下两行全宽卡片 ===== */
  @media (shape: pill-shaped) {
    .statusbar { justify-content: center; padding-left: 0; padding-right: 0; }
    .sb-block { align-items: center; }
    .time { font-size: 21px; }
    .app-title { font-size: 22px; }
    .cat-scroll { height: 128px; }
    .cat-row { padding-left: 28px; padding-right: 28px; }
    .cat-item { width: 95px; margin-right: 55px; }
    .cat-icon { width: 95px; height: 95px; border-radius: 47px; }
    .cat-icon-img { width: 55px; height: 55px; }
    .cat-text { font-size: 20px; margin-top: 6px; }
    .guide { font-size: 23px; letter-spacing: 0px; margin-top: 8px; }
    .search-box { width: 246px; height: 92px; border-radius: 46px; margin-top: 20px; border: 3px solid #3A3A3C; padding-left: 30px; }
    .search-box-icon { width: 40px; height: 40px; }
    .search-btn-row { flex-direction: column; padding-left: 0; padding-right: 0; margin-top: 0; }
    .search-btn { width: 220px; height: 96px; border-radius: 48px; flex: none; margin-top: 20px; padding-left: 24px; }
    .search-btn-l { margin-right: 0; }
    .search-btn-r { margin-left: 0; }
    .search-icon { width: 34px; height: 34px; margin-right: 10px; }
    .voice-tip { font-size: 36px; margin-bottom: 20px; }
    .voice-anim { width: 80px; height: 80px; }
    .voice-bt-off { width: 80px; height: 80px; margin-bottom: 20px; }
    .voice-cancel { width: 220px; height: 88px; border-radius: 44px; margin-top: 40px; }
    .voice-cancel-text { font-size: 36px; }
    .voice-text { font-size: 28px; }
    .search-text { font-size: 35px; }
    .statusbar { height: 91px; padding-top: 41px; }
    .cat-scroll { margin-top: 41px; }
    .search-btn-row { margin-top: 71px; }
    .searchbox-voice { height: 130px; }
    .sec2 { flex-direction: column; padding-left: 27px; padding-right: 27px; }
    .sec2-card { width: 100%; height: 108px; border-radius: 54px; flex-direction: row; justify-content: center; align-items: center; flex: none; }
    .sec2-card-first { margin-right: 0; margin-bottom: 14px; }
    .sec2-icon { width: 40px; height: 40px; margin-right: 12px; }
    /* 「收藏 · N」比「收藏」长，33px 会挤出卡片：降到 28px + 单行省略兜底 */
    .sec2-text { font-size: 28px; margin-top: 0; }
    /* 搜索层（胶囊屏）：与 result.ux 胶囊屏尺寸一致 */
    .search-placeholder { font-size: 30px; margin-left: 16px; }
    .search-input { font-size: 34px; margin-left: 16px; }
    .clear-btn { width: 46px; height: 46px; border-radius: 23px; font-size: 28px; line-height: 46px; margin-right: 22px; }
    .result-count { font-size: 24px; margin-top: 10px; }
    /* 胶囊结果卡加大：一屏约 3 个符合腕上观感（原约 6-7 个过小） */
    .ds-view { margin-top: 10px; }
    .ds-icon-box { width: 76px; height: 76px; border-radius: 38px; }
    .ds-icon { width: 44px; height: 44px; }
    .ds-name { font-size: 38px; margin-left: 16px; }
    .ds-desc { width: 90%; font-size: 24px; line-height: 34px; margin-bottom: 16px; }
    .ds-tags-scroll { height: 80px; }
    .ds-tag { height: 64px; border-radius: 32px; padding: 0 26px; margin-right: 12px; }
    .ds-tag-text { font-size: 28px; }
    .ds-actions { margin-top: 16px; }
    .ds-back { width: 44%; height: 84px; border-radius: 42px; }
    .ds-back-text { font-size: 32px; }
    .result-item { border-radius: 30px; padding: 26px 26px; margin-bottom: 18px; }
    .ai-card { width: 94%; margin-left: 3%; border-radius: 30px; padding: 22px 26px; margin-bottom: 16px; }
    .ai-card-title { font-size: 28px; margin-bottom: 10px; }
    .ai-card-text { font-size: 28px; line-height: 40px; }
    .more-btn { border-radius: 30px; height: 100px; margin-bottom: 16px; }
    .more-text { font-size: 32px; }
    .result-year { font-size: 44px; }
    .result-title { font-size: 54px; }
    .result-region { font-size: 36px; }
    .empty-tip { font-size: 28px; margin-top: 60px; }
    .engine-tip { font-size: 28px; }
    .sz-large { font-size: 54px; }
    .sz-medium { font-size: 40px; }
    .sz-small { font-size: 30px; }
  }
  /* 搜索框状态类（手环9固件禁动态style，改类切换） */
  .searchbox-voice { height: 80px; }
  .searchbox-typed { padding-left: 6px; }
</style>

<script>
  // 语音搜索 / AI 搜索统一引擎（真链路=interconnect 手机 App；模拟链路=本地可运行模拟源）
  import { getAssistant } from '../../SearchEngine/AssistantEngine.js'
  import router from '@system.router'
  import device from '@system.device'
  import prompt from '@system.prompt'
  import storage from '@system.storage'

  // 手写补零（避免 padStart 的轻量运行时兼容风险）
  function pad2(n) {
    return n < 10 ? '0' + n : '' + n
  }

  export default {
    private: {
      time: '00:00',
      timeTimer: null,
      statusbarHeight: 17,
      topBarPadTop: 0,
      catsMarginTop: 43,
      screen1H: 429,
      screenAdjusted: false,
      isCircle: false,
      showAppTitle: false,
      showRectTitle: false,
      guideText: '左右滑动 · 切换分类',
      curPage: 0,
      dotsTop: 200,
      catScrollTimer: null,
      pageScrollTimer: null,
      lastPageY: 0,
      lastCatScrollX: 0,
      snapParams: { iconW: 58, spacing: 17, count: 6, padLeft: 8.5, enabled: true },
      searchMarginTop: 0,
      categories: [
        { name: '健康', icon: '/common/icons/health.png', colorClass: 'ci-green' },
        { name: '科学', icon: '/common/icons/science.png', colorClass: 'ci-blue' },
        { name: '历史', icon: '/common/icons/history.png', colorClass: 'ci-orange' },
        { name: '生活', icon: '/common/icons/life.png', colorClass: 'ci-cyan' },
        { name: '急救', icon: '/common/icons/aid.png', colorClass: 'ci-red' },
        { name: '运动', icon: '/common/icons/sport.png', colorClass: 'ci-yellow' }
      ],
      displayCats: [],
      // 结果列表渐进显示（v1.16.26）：默认只渲染 5 条，避免一次渲染上百节点拖垮手环
      visibleCount: 5,
      // 资料详情视图（v1.16.31，主人需求）：点大类/资料后替换分类行，展示图标+简介+标签
      dsViewActive: false,
      // AI 搜索（v1.16.33）：aiMode=输入的问题将交给 AssistantEngine.answer 生成回答；
      // aiThinking=等待回答；aiAnswer=回答文案（本地由检索结果真实拼出）
      aiMode: false,
      aiThinking: false,
      aiAnswer: '',
      dsInfo: null,
      // 标签单独放顶层字段：模板 for 用嵌套属性（dsInfo.tags）不稳，且类名必须是纯变量插值
      dsTags: [],
      activeTag: null,
      // 资料入口清单（app.ux onCreate 挂 global）
      // 首页只渲染 groupEntries（大类，≤6 个 image——24 个资料集全渲染真机直接卡死）
      datasetEntries: [],
      groupEntries: [],
      activeGroupId: null,
      secondTitle: '选项',
      favoriteCount: 0,
      // 搜索态 screen1 显式高度（运行时不支持 height:auto）：结果条数 × 卡片高 + 顶部/底部余量，最小不低于一屏
      searchError: false,
      searchSeq: 0,
      // ===== 主页内嵌搜索层（状态/结果/键盘，逻辑参照 result.ux） =====
      searchActive: false,
      // 标题基础值（显示名由 computed headerTitle 按搜索态/资料视图状态合成）
      baseTitle: '搜索',
      activeDatasetId: null,
      screentype: 'rect',
      showKeyboard: false,
      shouldOpenKeyboard: false,
      isDestroyed: false,
      searchQuery: '',
      displayList: [],
      totalCount: 0,
      currentPage: 1,
      pageSize: 20,
      loading: false,
      allLoaded: false,
      searched: false,
      activeCategory: 'all',
      activeRegion: 'all',
      searchTimer: null,
      isClearing: false,
      showEngineTip: false,
      voiceActive: false,
      voiceFrames: [],
      voiceText: '请输入',
      voiceLevel: 0,
      bluetoothConnected: true,
      voiceTimer: null
    },

    computed: {
      // 键盘上方提示：无词「正在等待输入」、有词引导收起键盘（收键盘才触发搜索）
      waitTip() {
        if (this.showKeyboard) {
          return this.searchQuery && this.searchQuery.trim() ? '收起键盘开始搜索' : '请输入'
        }
        return '输入关键词开始搜索'
      },
      // 收藏卡片文案：有收藏显示「收藏 · N」，无收藏仍显示「收藏」
      favoriteText() {
        return this.favoriteCount > 0 ? '收藏 · ' + this.favoriteCount : '收藏'
      },
      // 键盘打开时追加光标（与输入组件内部光标一致，避免特殊字符缺字）
      displayQuery() {
        return this.searchQuery + (this.showKeyboard ? '_' : '')
      },
      // 搜索框状态类：语音态变高、有词缩边距（手环9固件禁动态style，改类切换）
      searchBoxClass() {
        var c = 'searchbox-normal'
        if (this.voiceActive) c = 'searchbox-voice'
        if (this.searchQuery) c += ' searchbox-typed'
        return c
      },
      // 当前波形帧（随模拟音量变化）
      voiceWaveSrc() {
        return '/common/icons/voice_wave_' + (this.voiceLevel + 1) + '.png'
      },
      // v1.16.18：分页指示点由「动态 style + 三元」改为「纯变量类名」
      //（交接块 #82 定稿：模板禁三元、动态 style 清零——否则滚动时反复重算属性，是卡顿来源）
      dot0Class() { return this.curPage === 0 ? 'page-dot page-dot-active' : 'page-dot' },
      dot1Class() { return this.curPage === 1 ? 'page-dot page-dot-active' : 'page-dot' },
      // 渐进显示：只渲染前 visibleCount 条（模板禁表达式，故在此切片）
      visibleList() {
        var n = this.visibleCount || 5
        return this.displayList.slice(0, n)
      },
      // 顶部标题合成（v1.16.37）：搜索态标题标注来源——资料视图内搜索显示「集名·搜索」，
      // 非搜索态在资料视图显示集名，其余显示应用名
      headerTitle() {
        if (this.dsViewActive && this.dsInfo) {
          return this.searchActive ? (this.dsInfo.name + '·搜索') : this.dsInfo.name
        }
        return this.searchActive ? this.baseTitle : '资料库'
      },
      // 语音面板状态：真链路=「聆听中」，模拟链路=「聆听中（演示）」——识别链路真实运行
      voiceStatusText() {
        try {
          var a = getAssistant()
          return a.getMode() === 'real' ? '聆听中…' : '聆听中·演示'
        } catch (e) { return '聆听中…' }
      },
      // AI 卡片文案（模板禁表达式，在此预拼）
      aiCardTitle() {
        return this.aiThinking ? 'AI 思考中…' : 'AI 回答'
      },
      aiCardText() {
        if (this.aiThinking) return '正在检索本地资料并生成回答…'
        return this.aiAnswer
      },
      moreText() {
        var rest = this.displayList.length - (this.visibleCount || 5)
        return rest > 0 ? ('显示更多（还有 ' + rest + ' 条）') : ''
      }
    },

    onInit() {
      // 资料入口动态化：显示真实安装的资料集（历史主集 + 蓝牙/内置资料集）
      try {
        // 入口清单由 app.ux onCreate 挂 global（避免 index 直接 import 库模块的双实例坑）
        this.datasetEntries = global.datasetEntries || []
        this.groupEntries = global.groupEntries || []
        console.log('[DS] entries=' + this.datasetEntries.length + ' groups=' + this.groupEntries.length)
      } catch (e) {
        console.log('[DS] datasetEntries 异常: ' + e.message)
      }
      // 优先大类入口（≤6 个，真机渲染不卡）；无分组数据回退资料集入口；再回退硬编码分类
      this.displayCats = this.groupEntries.length > 0
        ? this.groupEntries
        : (this.datasetEntries.length > 0 ? this.datasetEntries : this.categories)
      this.voiceFrames = [1, 2, 3, 4, 5, 6].map(function(i) {
        return { src: '/common/icons/voice_wave_' + i + '.png' }
      })
      this.updateTime()
      this.timeTimer = setInterval(() => { this.updateTime() }, 30000)
    },

    // onShow 时 DOM 已 ready，获取屏幕信息做形态/安全偏移适配（仅执行一次）
    onShow() {
      // 每次回主页都刷新收藏数（详情页/收藏列表增删后返回即时更新；只在此做，避免 onInit 异步回调丢失）
      this.refreshFavoriteCount()
      // 若此前提示「数据未加载」而引擎现已就绪（用户去设置加载完返回），自动清除提示并重搜
      var eng = global.searchEngine
      if (this.showEngineTip && eng && eng.isReady) {
        this.showEngineTip = false
        if (this.searchQuery && this.searchQuery.trim()) {
          this.resetAndSearch()
        }
      }
      if (this.screenAdjusted) return
      this.screenAdjusted = true
      this.adjustForScreen()
    },

    onDestroy() {
      this.isDestroyed = true
      if (this.timeTimer) clearInterval(this.timeTimer)
      if (this.catScrollTimer) clearTimeout(this.catScrollTimer)
      if (this.pageScrollTimer) clearTimeout(this.pageScrollTimer)
      if (this.searchTimer) clearTimeout(this.searchTimer)
      if (this.voiceTimer) clearInterval(this.voiceTimer)
    },

    updateTime() {
      var now = new Date()
      this.time = pad2(now.getHours()) + ':' + pad2(now.getMinutes())
    },

    // 屏幕形态判定（仅取键盘组件所需的 screentype；布局差异全部由 CSS @media 固化，
    // 手环9固件不支持动态 style 绑定——见 AI_CONTEXT #69）
    adjustForScreen() {
      var self = this
      device.getInfo({
        success: function(data) {
          var shape = data.screenShape
          self.screentype = shape === 'circle' ? 'circle' : (shape === 'pill-shaped' ? 'pill-shaped' : 'rect')
          // v1.16.3 补回 UI 状态（v1.14.0 精简时误删）：标题显隐 + 分页圆点位置
          self.showAppTitle = (shape === 'pill-shaped') || (shape === 'circle')
          self.showRectTitle = !self.showAppTitle
          var h = shape === 'pill-shaped' ? 766 : (shape === 'circle' ? 300 : 429)
          // ⚠️ screen1H 必须随形态更新：screen2 用 style="height:{{screen1H}}px" 定高，
          // 若恒为 data 初值 429，则整页总高 = screen1 + 429，滚动范围严重不足
          // → 第二屏底部（设置/收藏卡）永远滑不到（小米手环 pill 屏 766 上必现）
          self._fullScreenH = h
          self.screen1H = h
          self.dotsTop = Math.round(h / 2) - 16
          if (self.shouldOpenKeyboard) {
            self.shouldOpenKeyboard = false
            self.openKeyboardDelayed()
          }
        },
        fail: function() {
          if (self.shouldOpenKeyboard) {
            self.shouldOpenKeyboard = false
            self.openKeyboardDelayed()
          }
        }
      })
    },

    // 整页滚动：实时更新当前页指示，停止（debounce 150ms）后吸附到最近的整屏位置；
    // 搜索态下结果随外层滚动，不做双屏分页吸附
    onPageScroll(e) {
      var y = (e && e.scrollY) || 0
      this.lastPageY = y
      if (this.searchActive) return
      var h = this.screen1H || 429
      var page = Math.round(y / h)
      if (page < 0) page = 0
      if (page > 1) page = 1
      if (page !== this.curPage) this.curPage = page
      var self = this
      if (this.pageScrollTimer) clearTimeout(this.pageScrollTimer)
      this.pageScrollTimer = setTimeout(function() {
        self.snapPageScroll()
      }, 150)
    },

    // 吸附到最近的整屏位置：目标 scrollY = page * 屏设计高
    snapPageScroll() {
      var h = this.screen1H || 429
      var y = this.lastPageY || 0
      var page = Math.round(y / h)
      if (page < 0) page = 0
      if (page > 1) page = 1
      this.curPage = page
      var target = page * h
      if (Math.abs(target - y) > 1) {
        var el = this.$element('pageScroll')
        if (el) {
          el.scrollTo({ left: 0, top: target, behavior: 'smooth' })
        }
      }
    },

    // 分类横滑停止（debounce 150ms）后，把最近「两符号中点」对齐屏幕中心
    onCatScroll(e) {
      this.lastCatScrollX = (e && e.scrollX) || 0
      var self = this
      if (this.catScrollTimer) clearTimeout(this.catScrollTimer)
      this.catScrollTimer = setTimeout(function() {
        self.snapCatScroll()
      }, 150)
    },

    // 步长法计算吸附目标：gap 中点 = padLeft + i*step + iconW + spacing/2（step = iconW + spacing），
    // 目标 scrollX = gap - 视口中心(150)，钳制到 [0, 内容宽(含左右 padLeft) - 视口宽]
    snapCatScroll() {
      var p = this.snapParams
      if (!p || !p.enabled) return
      var scrollEl = this.$element('catScroll')
      if (!scrollEl) return
      var curX = this.lastCatScrollX || 0
      var step = p.iconW + p.spacing
      var padLeft = p.padLeft || 0
      var viewportW = 300
      var maxX = Math.max(0, (2 * padLeft + p.count * p.iconW + (p.count - 1) * p.spacing) - viewportW)
      var viewCenter = viewportW / 2
      var bestX = 0
      var bestDist = Infinity
      for (var i = 0; i < p.count - 1; i++) {
        var gap = padLeft + i * step + p.iconW + p.spacing / 2
        var target = gap - viewCenter
        if (target < 0) target = 0
        if (target > maxX) target = maxX
        var dist = Math.abs(target - curX)
        if (dist < bestDist) {
          bestDist = dist
          bestX = target
        }
      }
      // 已在吸附位附近则不重复滚动，避免循环
      if (Math.abs(bestX - curX) > 1) {
        scrollEl.scrollTo({ left: bestX, top: 0, behavior: 'smooth' })
      }
    },

    goSearch() {
      // AI 搜索（v1.16.33）：清掉资料集限定 → 进入 AI 提问模式（键盘输入问题，
      // 收起键盘后由 AssistantEngine 生成本地回答 + 来源列表；真机连手机时走云端应答）
      this.activeDatasetId = null
      this.activeGroupId = null
      this._resetSearchFilters()
      this.aiMode = true
      this.enterSearch()
    },

    // 语音搜索（v1.16.33）：进入聆听态 → AssistantEngine.recognize ——
    // 真链路=interconnect 发到手机 App 做 ASR 后回传文本；模拟链路=本地演示词源。
    // 两条链路共用此回调：识别文本真实填入搜索框并触发本地搜索（整条链路真实执行）。
    startVoiceSearch() {
      if (this.$app.$def.isNavigating) return
      if (this.voiceActive) return
      this.voiceActive = true
      this.log('[HOME-SEARCH] 语音搜索：进入聆听状态')
      this.checkBluetooth()
      var self = this
      // 模拟音量变化：随机切换波形帧
      this.voiceTimer = setInterval(function() {
        if (self && !self.isDestroyed) {
          self.voiceLevel = Math.floor(Math.random() * 6)
        }
      }, 300)
      getAssistant().recognize(function (r) {
        if (self.isDestroyed || !self.voiceActive) return
        if (r && r.ok && r.text) {
          self.log('[HOME-SEARCH] 语音识别（' + r.mode + '）：' + r.text)
          // 识别成功：退出聆听态 → 填词 → 走真实搜索
          self.exitVoiceSearch()
          self.activeDatasetId = null
          self.activeGroupId = null
          self._resetSearchFilters()
          self.aiMode = false
          self.enterSearch()
          self.searchQuery = r.text
          global.searchQuery = r.text
          self.loadPage(1, true)
        }
      })
    },

    // 退出语音聆听态（同时取消在途的识别请求）
    exitVoiceSearch() {
      this.voiceActive = false
      if (this.voiceTimer) {
        clearInterval(this.voiceTimer)
        this.voiceTimer = null
      }
      getAssistant().cancel()
      this.log('[HOME-SEARCH] 语音搜索结束')
    },

    // 检查蓝牙连接状态（未连接则提示并进入演示）
    checkBluetooth() {
      var self = this
      try {
        var interconnect = require('@system.interconnect')
        var conn = interconnect.instance()
        conn.getReadyState({
          success: function(data) {
            self.bluetoothConnected = data.status === 1
            if (!self.bluetoothConnected) {
              self.log('[HOME-SEARCH] 蓝牙未连接，进入演示', 'warn')
            }
          },
          fail: function() {
            self.bluetoothConnected = false
            self.log('[HOME-SEARCH] 蓝牙状态查询失败，进入演示', 'warn')
          }
        })
      } catch (e) {
        self.bluetoothConnected = false
        self.log('[HOME-SEARCH] interconnect 不可用，进入演示', 'warn')
      }
    },

    // 搜索框点击：键盘关着→进入搜索（弹键盘）；键盘开着→收起键盘（按键盘状态判断）；语音态不响应
    toggleSearchBox() {
      if (this.voiceActive) return
      if (this.showKeyboard) {
        this.toggleKeyboard()
      } else {
        this.enterSearch()
      }
    },

    goCategory(item) {
      // 大类入口(isGroup)：限定只搜该大类下所有集；资料集入口(isDataset)：只搜该集；
      // 普通分类：按分类名搜索（历史语义）。两条限定入口共用同一段进搜索层逻辑
      var isDs = !!(item && item.isDataset)
      var isGrp = !!(item && item.isGroup)
      if (isDs || isGrp) {
        // v1.16.31（主人需求）：点资料不再直接进搜索态，而是切到「资料详情视图」，
        // 展示该资料的图标/简介/标签；在此输入关键词、或点标签缩小范围后再搜。
        // v1.16.12 起 6 标签与 6 资料集是 1:1 对应（GROUP_MAP 的 datasets 均为单元素），
        // 故大类入口可直接用 groupId 作为资料集 id，无需访问 GROUP_MAP（index 页不可见库模块）
        var dsId = isDs ? item.dsId : (isGrp ? item.groupId : null)
        var info = (dsId !== null && typeof global.getDatasetInfo === 'function') ? global.getDatasetInfo(dsId) : null
        if (info) {
          this.enterDatasetView(info)
          return
        }
        this.activeDatasetId = isDs ? item.dsId : null
        this.activeGroupId = isGrp ? item.groupId : null
        this.baseTitle = item.name
        // 清空旧词与旧结果，直接显示结果区空态引导（不能走 enterSearch('')：
        // 空串走 else 分支会把 searchTitle 覆盖回「搜索」、searchActive 取决于残留旧词，
        // 且旧 displayList 不会被清掉——资料集空态里残留上一次搜索结果）
        this.searchQuery = ''
        global.searchQuery = ''
        this.displayList = []
        this.totalCount = 0
        this.currentPage = 1
        this.allLoaded = false
        this.searched = false
        this.searchError = false
        this.showEngineTip = false
        this.searchActive = true
        this._applySearchLayout(true)
        this.log('[HOME-SEARCH] 进入' + (isGrp ? '大类 ' : '资料集 ') + item.name +
          (isDs ? ' dsId=' + item.dsId : ' groupId=' + item.groupId))
        var pageScrollEl = this.$element('pageScroll')
        if (pageScrollEl) {
          pageScrollEl.scrollTo({ left: 0, top: 0, behavior: 'smooth' })
        }
        if (this.screenAdjusted && this.screentype) {
          this.openKeyboardDelayed()
        } else {
          this.shouldOpenKeyboard = true
        }
        return
      }
      this.enterSearch(item)
    },

    // 复位全部筛选条件（标签/分类/地区）——否则「点标签筛选 → 退出搜索」会把限定
    // 带到下一次普通搜索，其他 5 个集全部为空，用户会以为搜索坏了。
    _resetSearchFilters() {
      this.activeRegion = 'all'
      this.activeTag = null
      this.activeCategory = 'all'
    },

    goSettings() {
      if (this.$app.$def.isNavigating) return
      router.push({ uri: '/pages/settings' })
    },

    // 读收藏列表数量：JSON.parse 后取 length，解析异常/读取失败按 0
    refreshFavoriteCount() {
      var self = this
      storage.get({
        key: 'favorite_list',
        success: function(data) {
          var count = 0
          try {
            var list = JSON.parse(data) || []
            count = list.length
          } catch(e) {
            count = 0
          }
          self.favoriteCount = count
        },
        fail: function() {
          self.favoriteCount = 0
        }
      })
    },

    goFavorites() {
      if (this.$app.$def.isNavigating) return
      router.push({ uri: '/pages/favorites' })
    },

    // ===== 主页内嵌搜索层（逻辑照搬 result.ux，不跳转 result 页） =====

    // 统一日志：console + runtime log（level 默认 info）
    log(msg, level) {
      console.log(msg)
      if (typeof global.addRuntimeLog === 'function') {
        global.addRuntimeLog(msg, level || 'info')
      }
    },

    // ===== 搜索态布局切换（v1.16.37）=====
    // screen1 高度：非搜索态=整屏（与第二屏双屏吸附）；搜索态=头部高（状态栏+搜索框），
    // 让结果区（pageScroll 直接子项）紧跟头部，随内容自然撑高、单层滚动。
    // 头部高与 CSS 联动（rect: statusbar 22 + searchbox 16+56；pill: statusbar 91+padding 41 + searchbox 20+92），
    // 改这两处 CSS 时必须同步这里；取保守上限（宁多勿少，多了只是搜索框下多几px空隙，少了会裁搜索框）
    _searchHeaderH() {
      if (this.screentype === 'pill-shaped') return 260
      if (this.screentype === 'circle') return 130
      return 104
    },
    _applySearchLayout(searching) {
      var full = this._fullScreenH || 429
      this.screen1H = searching ? this._searchHeaderH() : full
    },

    // 进入搜索：搜索框/搜索按钮只弹键盘（分类行保留、被键盘盖住，无内容替换切换感）；
    // 分类图标进入则清空词并显示结果区；统一延迟 150ms 弹键盘（先让组件 mount）
    enterSearch(category) {
      if (category) {
        global.searchCategory = category
        this.activeCategory = category
        this.baseTitle = category + '搜索'
        // 点分类图标进入：清空旧词重新输入该分类关键词，避免旧结果串分类
        this.searchQuery = ''
        global.searchQuery = ''
        this.displayList = []
        this.totalCount = 0
        this.currentPage = 1
        this.allLoaded = false
        this.searched = false
        this.showEngineTip = false
        this.searchActive = true // 分类进入：显示结果区（空态引导输入）
        this._applySearchLayout(true)
      } else {
        this.activeCategory = 'all'
        // 通用搜索入口：清掉资料集限定（上次进过某资料集后，普通搜索不应仍只搜该集）；
        // 资料视图内例外——保持该集限定、直接进入结果区布局（标题由 headerTitle 标注「集名·搜索」）
        if (this.dsViewActive) {
          this.searchActive = true
          this._applySearchLayout(true)
        } else {
          this.activeDatasetId = null
          this.activeGroupId = null
          this.baseTitle = '搜索'
          // 搜索框/搜索按钮进入：不切换下方内容（搜索框/分类行保持），仅弹键盘；
          // 有残留搜索词才显示结果区，无词保持分类行可见 → 无「内容替换」切换感
          this.searchActive = !!(this.searchQuery && this.searchQuery.trim())
          this._applySearchLayout(this.searchActive)
        }
      }
      this.log('[HOME-SEARCH] 进入搜索层 词=' + this.searchQuery + ' category=' + (category || 'all'))
      // 回滚到顶部
      var pageScrollEl = this.$element('pageScroll')
      if (pageScrollEl) {
        pageScrollEl.scrollTo({ left: 0, top: 0, behavior: 'smooth' })
      }
      // 进入搜索态统一弹键盘（无词引导输入；有词可继续编辑）
      if (this.screenAdjusted && this.screentype) {
        this.openKeyboardDelayed()
      } else {
        this.shouldOpenKeyboard = true
      }
    },

    // 延迟 150ms 弹键盘：先让 input-method 组件完成 mount（构建 DOM + 加载键盘图）再显示
    openKeyboardDelayed() {
      var self = this
      setTimeout(function() {
        if (self && !self.isDestroyed) {
          self.showKeyboard = true
          self.log('[HOME-SEARCH] 键盘开')
        }
      }, 150)
    },

    // 退出搜索：清空搜索状态回主页（下次点击重新开始）；回滚到顶部。
    // 从资料视图进入的搜索：退出后回到该资料视图（保留集限定与标题），不回顶层分类行
    exitSearch() {
      this.searchActive = false
      this._applySearchLayout(false)
      this.showKeyboard = false
      this.searchQuery = ''
      global.searchQuery = ''
      // 资料集限定：资料视图保留（视图还在），普通搜索清掉
      if (!this.dsViewActive) {
        this.activeDatasetId = null
        this.activeGroupId = null
        this.baseTitle = '搜索'
      }
      this._resetSearchFilters()
      this.aiMode = false
      this.aiThinking = false
      this.aiAnswer = ''
      this.searchSeq++
      this.loading = false
      this.searchError = false
      this.displayList = []
      this.totalCount = 0
      this.currentPage = 1
      this.allLoaded = false
      this.searched = false
      this.showEngineTip = false
      this.log('[HOME-SEARCH] 退出搜索层')
      var pageScrollEl = this.$element('pageScroll')
      if (pageScrollEl) {
        pageScrollEl.scrollTo({ left: 0, top: 0, behavior: 'smooth' })
      }
    },

    // 点搜索框：开/收键盘，收起时触发搜索
    toggleKeyboard() {
      if (this.isClearing) return
      this.shouldOpenKeyboard = false // 用户已手动操作，getInfo 回调不再自动弹键盘
      this.showKeyboard = !this.showKeyboard
      if (this.showKeyboard) {
        this.log('[HOME-SEARCH] 键盘开')
      } else {
        this.finishInput() // 内部会记「键盘关」并搜索
      }
    },

    // 收起键盘并搜索（搜索为同步阻塞计算，界面在返回前不会刷新，故不做加载动画）
    finishInput() {
      this.showKeyboard = false
      this.log('[HOME-SEARCH] 键盘关')
      if (this.aiMode) {
        this.runAiSearch()
        return
      }
      this.resetAndSearch()
    },

    // AI 搜索执行：问题交给 AssistantEngine（真链路=手机云端应答；模拟=本地理解+检索+摘要）
    runAiSearch() {
      var self = this
      var q = (this.searchQuery || '').trim()
      if (!q) { this.aiMode = false; this.resetAndSearch(); return }
      this.aiThinking = true
      this.aiAnswer = ''
      this.log('[HOME-SEARCH] AI 搜索：' + q + '（链路=' + getAssistant().getMode() + '）')
      var searchFn = function (kw) {
        // 复用既有搜索通道（走 global.searchHistory → searchAllAsync → 六集引擎）
        return Promise.resolve().then(function () {
          return global.searchHistory(kw, { page: 1, pageSize: 5, category: 'all', region: 'all' })
        })
      }
      getAssistant().answer(q, searchFn, function (r) {
        if (self.isDestroyed) return
        self.aiThinking = false
        if (r && r.ok) {
          self.aiAnswer = r.answer
          // AI 回答附带的来源条目直接进入结果列表（点击可看详情，与普通结果一致）
          var items = r.results || []
          var formatted = items.map(function (item) {
            return {
              id: item.id || item._id,
              yearDisplay: item.yearDisplay || (r.keyword || ''),
              title: (item.title || '').split(/[，,]/)[0],
              region: item.region || 'AI 来源',
              yearClass: item.yearClass || 'result-year',
              titleClass: item.titleClass || 'result-title',
              catClass: item.catClass || 'result-region'
            }
          })
          self.displayList = formatted
          self.visibleCount = 5
          self.totalCount = r.total || formatted.length
          self.searched = true
          self.allLoaded = true
          self.log('[HOME-SEARCH] AI 回答就绪：' + r.answer)
        } else {
          self.aiAnswer = 'AI 搜索暂不可用，请稍后再试。'
          self.searched = true
        }
      })
    },


    // 清空关键词（清空时保持键盘打开状态，可继续输入；恢复分类行）
    clearSearch() {
      this.isClearing = true
      this.searchQuery = ''
      global.searchQuery = ''
      // 作废在途搜索请求，避免清空后旧结果又写回列表
      this.searchSeq++
      this.loading = false
      this.searchError = false
      this.displayList = []
      this.totalCount = 0
      this.currentPage = 1
      this.allLoaded = false
      this.searched = false
      this.searchActive = false
      this._applySearchLayout(false)
      var self = this
      setTimeout(function() { self.isClearing = false }, 200)
    },

    // @complete：键盘逐字符提交，仅追加关键词（不实时搜索——收起键盘才搜一次）；有词时切结果区
    onInput(evt) {
      var content = evt.detail.content
      console.log('[KB] page onInput content=' + content)
      if (content === undefined || content === null) return
      this.searchQuery += content
      global.searchQuery = this.searchQuery
      if (this.searchQuery.trim()) {
        this.searchActive = true
        this._applySearchLayout(true)
      }
    },

    // @delete：键盘内部缓冲已空时，删除页面关键词末字符；删空恢复分类行
    onDelete() {
      this.searchQuery = this.searchQuery.slice(0, -1)
      global.searchQuery = this.searchQuery
      if (!this.searchQuery.trim()) {
        this.searchActive = false
        this._applySearchLayout(false)
      }
    },

    // 重置分页并搜索第 1 页；引擎未初始化时由 search 内部懒初始化（自动读缓存建缓存），
    // 不再需要手动「加载数据」；数据缺失时 search 返回 initFailed，由 loadPage 显示提示
    resetAndSearch() {
      var eng = global.searchEngine
      if (!eng) {
        this.showEngineTip = true
        this.displayList = []
        this.totalCount = 0
        this.currentPage = 1
        this.allLoaded = false
        this.searched = true
        this.searchActive = true
        this._applySearchLayout(true)
        this.log('[HOME-SEARCH] 引擎实例不存在，提示检查')
        return
      }
      this.showEngineTip = false
      if (!this.searchQuery || !this.searchQuery.trim()) {
          this.displayList = []
        this.totalCount = 0
        this.currentPage = 1
        this.allLoaded = false
        this.searched = false
        this.searchActive = false
        this._applySearchLayout(false)
        // 作废在途搜索并复位加载/错误态，避免旧请求结果稍后写回空列表
        this.searchSeq++
        this.loading = false
        this.searchError = false
        return
      }
      this.currentPage = 1
      this.allLoaded = false
      this.searched = true
      this.searchActive = true
      this._applySearchLayout(true)
      this.searchError = false
      this.loadPage(1, true)
    },

    // force=true：新搜索第 1 页，不受 loading/allLoaded 守卫限制（否则旧请求在途时
    // 新搜索被静默吞掉，界面残留旧词的结果）；翻页走 onPageScrollBottom 不带 force
    async loadPage(page, force) {
      if (!force && (this.loading || this.allLoaded)) return
      if (!this.searchQuery || !this.searchQuery.trim()) return
      this.loading = true
      // 请求代际号：await 期间若用户又发起新搜索/清空/退出，代际号变化，
      // 旧响应直接丢弃，防止旧词结果覆盖新词（快速连续搜索竞态）
      var seq = ++this.searchSeq
      var startTime = Date.now()
      try {
        // ⚠️ 超时保险（v1.16.23）：快应用下 @system.file.readText 回调可能丢失（见 AI_CONTEXT
        // #18/#84 记载的 jsc 模式雷）。任一集的读文件卡住 → searchAllAsync 的 Promise.all
        // 永久挂起 → 此 await 永不返回 → this.loading 恒为 true，页面表现为「一直搜索中、
        // 连『无结果』提示都不出现」。这里 10s 兜底，超时按空结果处理并给出提示。
        var result = await Promise.race([
          global.searchHistory(this.searchQuery, {
            category: this.activeCategory,
            region: this.activeRegion,
            page: page,
            pageSize: this.pageSize,
            datasetId: this.activeDatasetId,
            groupId: this.activeGroupId
          }),
          new Promise(function(resolve) {
            setTimeout(function() { resolve({ results: [], total: 0, timedOut: true }) }, 10000)
          })
        ])
        if (seq !== this.searchSeq) return // 已被更新的搜索取代，丢弃过期结果
        // 数据缺失兜底：引擎懒初始化失败（meta 读不到）时提示去设置检查
        if (result.initFailed) {
          this.showEngineTip = true
          this.displayList = []
          this.totalCount = 0
          this.loading = false
          this.log('[HOME-SEARCH] 引擎数据缺失，提示检查')
          return
        }
        var formatted = (result.results || []).map(function(item) {
          // 取第一个关键词作为标题
          var title = item.title || '未知事件'
          if (title.indexOf(',') !== -1) {
            title = title.split(',')[0].trim()
          } else if (title.indexOf('，') !== -1) {
            title = title.split('，')[0].trim()
          }
          return {
            id: item.id || item._id,
            yearDisplay: item.yearDisplay || '未知',
            title: title,
            region: item.region || '未知',
            // 三行大小类透传（DatasetManager 按 meta.display.card 预拼；缺省回退页面基准）
            yearClass: item.yearClass || 'result-year',
            titleClass: item.titleClass || 'result-title',
            catClass: item.catClass || 'result-region'
          }
        })
        // 列表封顶（v1.16.25）：原先无限 concat，翻 10 页即 200 条 × 4 个节点 = 800 节点，
        // 手环上直接拖垮渲染；同时它也是下方高度公式线性膨胀的根源。只保留最近 MAX_ROWS 条。
        var MAX_ROWS = 100
        if (page === 1) {
          this.displayList = formatted
          this.visibleCount = 5        // 新搜索：回到「只显示 5 条」的初始态
        } else {
          this.displayList = this.displayList.concat(formatted)
          if (this.displayList.length > MAX_ROWS) {
            this.displayList = this.displayList.slice(this.displayList.length - MAX_ROWS)
          }
        }
        this.totalCount = result.total || 0
        this.currentPage = page
        this.loading = false
        if (formatted.length < this.pageSize) {
          this.allLoaded = true
        }
        var elapsed = Date.now() - startTime
        if (page === 1) {
          this.log('[HOME-SEARCH] 搜索词=' + this.searchQuery + ' 结果数=' + this.totalCount + ' 耗时=' + elapsed + 'ms')
        } else {
          this.log('[HOME-SEARCH] 加载第' + page + '页 新增' + formatted.length + '条 当前总数' + this.totalCount)
        }
      } catch (e) {
        console.error('[loadPage] 错误:', e)
        if (seq !== this.searchSeq) return
        this.loading = false
        // 错误态可见：此前 catch 只静默复位 loading，界面停留在旧列表/无任何提示
        this.searchError = true
        }
    },

    // ===== 资料详情视图（v1.16.31）=====
    // 进入某资料的详情视图：设置当前集 + 预拼标签选中态（模板只做纯变量插值）
    enterDatasetView(info) {
      var tags = []
      for (var i = 0; i < info.tags.length; i++) {
        tags.push({ label: info.tags[i].label, value: info.tags[i].value, cls: 'ds-tag' })
      }
      this.dsInfo = { id: info.id, name: info.name, icon: info.icon, desc: info.desc, colorClass: info.colorClass }
      this.dsTags = tags
      this.dsViewActive = true
      this.activeDatasetId = info.id
      this.activeGroupId = null
      // 标签筛选复位（新进资料不预设标签）
      this.activeTag = null
      this.activeRegion = 'all'
      // 标题由 computed headerTitle 按视图状态合成（这里只留基础值兜底）
      this.baseTitle = info.name
      this.displayList = []
      this.searched = false
      this.log('[HOME-SEARCH] 进入资料视图 ' + info.name + ' dsId=' + info.id)
    },

    // 点标签：只搜带该标签的资料（再点一次取消）
    pickTag(tag) {
      var same = (this.activeTag === tag.value)
      this.activeTag = same ? null : tag.value
      // 引擎按 regionList 比对，直接复用已有的 region 筛选通道
      this.activeRegion = this.activeTag || 'all'
      // 重设每个标签的类名（选中=蓝色高亮）
      var tags = []
      var src = this.dsTags
      for (var i = 0; i < src.length; i++) {
        var on = (src[i].value === this.activeTag)
        tags.push({ label: src[i].label, value: src[i].value, cls: on ? 'ds-tag ds-tag-on' : 'ds-tag' })
      }
      this.dsTags = tags
      this.log('[HOME-SEARCH] 标签筛选 ' + (this.activeTag || '全部'))
      // 已输入关键词则立即按新范围重搜
      if (this.searchQuery && this.searchQuery.trim()) {
        this.currentPage = 1
        this.allLoaded = false
        this.searched = false
        this.searchActive = true
        this._applySearchLayout(true)
        this.loadPage(1, true)
      }
    },

    // 退出资料视图，回到分类横滑行
    exitDsView() {
      this.dsViewActive = false
      this.dsInfo = null
      this.activeTag = null
      this.activeRegion = 'all'
      this.activeDatasetId = null
      this.displayList = []
      this.searched = false
    },

    // 显示更多（v1.16.26）：每次追加 5 条；若本地已显示完但仍未加载完全部结果，
    // 顺带拉下一页（这样「更多」既能展开本地已取到的，也能继续向后取）
    showMore() {
      this.visibleCount = (this.visibleCount || 5) + 5
      if (this.visibleCount >= this.displayList.length && !this.allLoaded && !this.loading) {
        this.loadPage(this.currentPage + 1)
      }
    },

    // 搜索态滚到底：自动加载下一页（键盘弹出时不触发；非搜索态双屏滚动不翻页）
    onPageScrollBottom() {
      if (!this.searchActive) return
      if (this.showKeyboard) return
      if (this.loading || this.allLoaded) return
      if (!this.displayList.length) return
      this.loadPage(this.currentPage + 1)
    },

    gotoDetail(id) {
      if (this.showKeyboard) return
      if (this.$app.$def.isNavigating) return
      if (typeof global.addRuntimeLog === 'function') {
        global.addRuntimeLog('从结果页打开详情: ID=' + id, 'info')
      }
      global.selectedEventId = id
      router.push({ uri: '/pages/detail' })
    },

    // 右滑：语音态退出聆听，键盘开着先收起，再退出搜索态回主页（非搜索态主页右滑不处理）
    onSwipe(eve) {
      if (eve.direction !== 'right') return
      if (this.voiceActive) {
        this.exitVoiceSearch()
        return
      }
      if (this.showKeyboard) {
        this.finishInput()
        return
      }
      if (this.searchActive) {
        this.exitSearch()
      }
    }
  }
</script>
